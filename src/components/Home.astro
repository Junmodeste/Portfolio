---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/photo.jpg';
import { profile, projects, career, earlySteps, education, events, ui, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const featured = projects.find((p) => p.featured);
const others = projects.filter((p) => !p.featured);
// Les descriptions utilisent `code` en Markdown léger.
const md = (s: string) => s.replace(/`([^`]+)`/g, '<code class="rounded bg-accent-soft px-1 py-0.5 text-[0.9em]">$1</code>');
const section = 'mx-auto max-w-6xl px-4 sm:px-6';
---

<section class={`${section} grid items-center gap-10 pt-12 pb-20 sm:pt-20 sm:pb-28 md:grid-cols-[1fr_auto]`}>
  <Image
    src={photo}
    alt={profile.name}
    widths={[160, 320, 400]}
    sizes="(min-width: 768px) 288px, 128px"
    loading="eager"
    class="size-32 rounded-full object-cover ring-4 ring-accent-soft md:order-last md:size-72"
  />
  <div>
  <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 text-sm text-muted">
    <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
    {t.role}
  </p>
  <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">{profile.name}</h1>
  <p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">{t.pitch}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href="#projets"
      class="inline-flex min-h-11 items-center rounded-lg bg-accent px-5 font-semibold text-on-accent transition-opacity duration-200 hover:opacity-90"
      >{t.ctaProjects}</a
    >
    <a
      href="#contact"
      class="inline-flex min-h-11 items-center rounded-lg border border-line bg-card px-5 font-semibold transition-colors duration-200 hover:border-accent"
      >{t.ctaContact}</a
    >
  </div>
  <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
    {
      t.facts.map((f) => (
        <li class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
          {f}
        </li>
      ))
    }
  </ul>
  </div>
</section>

<section id="projets" class={`${section} py-16`} aria-labelledby="projets-title">
  <div class="reveal mb-10">
    <h2 id="projets-title" class="text-3xl font-semibold tracking-tight">{t.projectsTitle}</h2>
    <p class="mt-2 text-muted">{t.projectsIntro}</p>
  </div>

  {
    featured && (
      <article class="reveal mb-6 rounded-2xl border border-line bg-card p-6 sm:p-8">
        <p class="text-sm font-semibold text-accent">{t.featured}</p>
        <h3 class="mt-2 text-2xl font-semibold">{featured.name}</h3>
        <p class="mt-3 max-w-3xl text-muted" set:html={md(featured.description[lang])} />
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
          {featured.tags.map((tag) => (
            <li class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">{tag}</li>
          ))}
        </ul>
        <a
          href={featured.repo}
          class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-accent hover:underline"
        >
          {t.viewCode}
          <span class="sr-only">: {featured.name}</span>
          <Icon name="arrow-up-right" class="size-4" />
        </a>
      </article>
    )
  }

  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      others.map((p) => (
        <li class="reveal">
          <article class="group relative flex h-full flex-col rounded-2xl border border-line bg-card p-6 transition-colors duration-200 hover:border-accent">
            <h3 class="font-display text-lg font-semibold break-words">
              <a href={p.site || p.repo} class="after:absolute after:inset-0 after:rounded-2xl">
                {p.name}
              </a>
            </h3>
            <p class="mt-2 flex-1 text-sm text-muted" set:html={md(p.description[lang])} />
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
              {p.tags.map((tag) => (
                <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{tag}</li>
              ))}
            </ul>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent" aria-hidden="true">
              {p.site ? t.viewSite : t.viewCode}
              <Icon name="arrow-up-right" class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </span>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<section id="expertise" class={`${section} py-16`} aria-labelledby="expertise-title">
  <h2 id="expertise-title" class="reveal mb-10 text-3xl font-semibold tracking-tight">{t.expertiseTitle}</h2>
  <ul class="grid gap-6 sm:grid-cols-2">
    {
      t.expertise.map((item, i) => (
        <li class:list={['reveal flex gap-4 rounded-2xl border border-line bg-card p-6', i === 0 && 'sm:col-span-2']}>
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
            <Icon name={item.icon} />
          </span>
          <div>
            <h3 class="font-semibold">{item.title}</h3>
            <p class="mt-1 text-sm text-muted">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section id="parcours" class={`${section} py-16`} aria-labelledby="parcours-title">
  <h2 id="parcours-title" class="reveal mb-10 text-3xl font-semibold tracking-tight">{t.experienceTitle}</h2>

  <article class="reveal rounded-2xl border border-line bg-card p-6 sm:p-8">
    <p class="text-sm text-muted">{career.period[lang]} · {career.city}</p>
    <h3 class="mt-1 text-2xl font-semibold">{career.org}</h3>

    <ol class="mt-5 flex flex-wrap items-center gap-2 text-sm" aria-label={t.experienceTitle}>
      {
        career.steps.map((step, i) => {
          const last = i === career.steps.length - 1;
          return (
            <li class="flex items-center gap-2">
              <span
                class:list={[
                  'rounded-full px-3 py-1 font-semibold',
                  last ? 'bg-accent text-on-accent' : 'border border-line text-muted',
                ]}
              >
                {step[lang]}
                {last && <span class="sr-only"> ({t.current})</span>}
              </span>
              {!last && <Icon name="arrow-right" class="size-4 text-muted" />}
            </li>
          );
        })
      }
    </ol>

    <p class="mt-5 max-w-3xl text-muted">{career.story[lang]}</p>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        career.highlights.map((h) => (
          <li class="flex gap-3 rounded-xl bg-accent-soft p-4 text-sm">
            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
            {h[lang]}
          </li>
        ))
      }
    </ul>
  </article>

  <p class="reveal mt-4 text-sm text-muted">{earlySteps[lang]}</p>

  <h3 class="reveal mt-14 mb-6 text-xl font-semibold">{t.educationTitle}</h3>
  <ul class="grid gap-6 sm:grid-cols-3">
    {
      education.map((d) => (
        <li class="reveal rounded-2xl border border-line bg-card p-6">
          <p class="font-display text-3xl font-bold text-accent">{d.year}</p>
          <h4 class="mt-2 font-semibold">{d.title[lang]}</h4>
          <p class="text-sm text-muted">{d.school}</p>
          <p class="mt-3 text-sm">{d.note[lang]}</p>
        </li>
      ))
    }
  </ul>
</section>

{
  events.length > 0 && (
    <section id="evenements" class={`${section} py-16`} aria-labelledby="evenements-title">
      <div class="reveal mb-10">
        <h2 id="evenements-title" class="text-3xl font-semibold tracking-tight">{t.eventsTitle}</h2>
        <p class="mt-2 text-muted">{t.eventsIntro}</p>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {events.map((e) => (
          <li class="reveal">
            <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-card transition-colors duration-200 hover:border-accent">
              {e.image ? (
                <Image
                  src={e.image}
                  alt=""
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 352px, (min-width: 640px) 50vw, 100vw"
                  class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
              ) : (
                <span class="m-6 mb-0 grid size-11 place-items-center rounded-xl bg-accent-soft text-accent">
                  <Icon name="calendar" />
                </span>
              )}
              <div class="flex flex-1 flex-col p-6">
                <p class="text-sm text-muted">
                  {e.date[lang]} · {e.place}
                </p>
                <h3 class="mt-1 font-display text-lg font-semibold">
                  <a href={e.url} class="after:absolute after:inset-0 after:rounded-2xl">
                    {e.name}
                  </a>
                </h3>
                <p class="mt-1 flex-1 text-sm text-muted">{e.role[lang]}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent" aria-hidden="true">
                  {t.viewEvent}
                  <Icon name="arrow-up-right" class="size-4" />
                </span>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  )
}

<section id="contact" class={`${section} py-16 pb-24`} aria-labelledby="contact-title">
  <div class="reveal rounded-2xl bg-accent px-6 py-12 text-on-accent sm:px-12">
    <h2 id="contact-title" class="text-3xl font-semibold tracking-tight">{t.contactTitle}</h2>
    <p class="mt-3 max-w-2xl opacity-90">{t.contactText}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-on-accent px-5 font-semibold text-accent transition-opacity duration-200 hover:opacity-90"
      >
        <Icon name="mail" class="size-5" />
        {t.contactEmail}
      </a>
      <a
        href={profile.github}
        class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-current/40 px-5 font-semibold transition-colors duration-200 hover:bg-white/10"
      >
        <Icon name="github" class="size-5" />
        GitHub
      </a>
      {
        profile.linkedin && (
          <a
            href={profile.linkedin}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-current/40 px-5 font-semibold transition-colors duration-200 hover:bg-white/10"
          >
            <Icon name="linkedin" class="size-5" />
            LinkedIn
          </a>
        )
      }
    </div>
    <p class="mt-6 text-sm opacity-90">{profile.email}</p>
  </div>
</section>
