---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile, ui, events, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = lang === 'fr' ? base : `${base}en/`;
const otherHome = lang === 'fr' ? `${base}en/` : base;
const canonical = new URL(home, Astro.site);

const nav = [
  { href: '#projets', label: t.nav.projects },
  { href: '#expertise', label: t.nav.expertise },
  { href: '#parcours', label: t.nav.experience },
  ...(events.length ? [{ href: '#evenements', label: t.nav.events }] : []),
  { href: '#contact', label: t.nav.contact },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(base, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}en/`, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#714B67" />
    <script is:inline>
      // Avant le premier rendu : thème choisi, sinon celui du système (pas de flash).
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
      >{t.skip}</a
    >

    <header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href={home} class="flex min-h-11 items-center gap-2 font-display font-semibold tracking-tight">
          <span class="grid size-9 place-items-center rounded-lg bg-accent text-sm font-bold text-on-accent">MK</span>
          <span class="hidden sm:inline">{profile.name}</span>
        </a>

        <nav aria-label="Navigation" class="hidden md:block">
          <ul class="flex items-center gap-1 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="rounded-lg px-3 py-2 text-muted transition-colors duration-200 hover:bg-accent-soft hover:text-fg"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-1">
          <a
            href={otherHome}
            hreflang={lang === 'fr' ? 'en' : 'fr'}
            aria-label={t.langSwitchLabel}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm text-muted transition-colors duration-200 hover:bg-accent-soft hover:text-fg"
          >
            <Icon name="languages" class="size-4" />
            {t.langSwitch}
          </a>
          <button
            type="button"
            id="theme-toggle"
            aria-label={t.themeToggle}
            class="grid size-11 cursor-pointer place-items-center rounded-lg text-muted transition-colors duration-200 hover:bg-accent-soft hover:text-fg"
          >
            <Icon name="moon" class="size-5 dark:hidden" />
            <Icon name="sun" class="hidden size-5 dark:block" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p>© {new Date().getFullYear()} {profile.name}. {t.footer}</p>
        <a href="https://github.com/Junmodeste/Portfolio" class="inline-flex min-h-11 items-center gap-2 hover:text-fg">
          <Icon name="github" class="size-4" />
          {t.source}
        </a>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = root.classList.toggle('dark');
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
